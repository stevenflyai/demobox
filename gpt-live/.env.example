# ─────────────────────────────────────────────────────────────
# GPT-Live demo: fill in BASE_URL and API_KEY, then run:
#   npm install
#   npm start          (opens on http://localhost:3000)
# ─────────────────────────────────────────────────────────────

# Your Azure OpenAI / Microsoft Foundry resource endpoint.
# Any of these forms works (the server normalizes it to .../openai/v1):
#   https://<resource>.openai.azure.com
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.cognitiveservices.azure.com
# For OpenAI directly use: https://api.openai.com/v1
BASE_URL=

# Resource key (Azure portal → your resource → Keys and Endpoint).
# Stays on the server; the browser never sees it.
API_KEY=


# ───────────── Optional ─────────────

# Deployment name of gpt-live-1 in the resource above
GPT_LIVE_MODEL=gpt-live-1

# Default voice (can be changed in the UI). marin is the documented default.
GPT_LIVE_VOICE=marin

# Backend model GPT-Live delegates reasoning and tool calls to
# (deployment name in the same resource). Leave empty to run GPT-Live
# on its own with no tools.
DELEGATION_MODEL=gpt-5.5
# Reasoning effort for the backend model (minimal | low | medium | high).
# Leave empty if your backend model doesn't support reasoning.
DELEGATION_REASONING_EFFORT=low

# Add the hosted web_search tool to the backend (only if your resource supports it)
ENABLE_WEB_SEARCH=false

# How the key is sent: auto (api-key header for Azure hosts, Bearer otherwise) | api-key | bearer
AUTH_HEADER=auto

PORT=3000

# Print every non-audio event in the server console
DEBUG=false
