# ─────────────────────────────────────────────────────────────
# Image models demo: fill in the GPT-Image and MAI resources, then run:
#   npm start          (opens on http://localhost:3002)
# A model with no URL or key is shown as "not configured";
# the others still run.
# ─────────────────────────────────────────────────────────────

# ───────────── GPT-Image (Flare and Sunburst) ─────────────
# Azure OpenAI / Foundry resource where gpt-image-2.5-flare and -sunburst are
# deployed. Any of these forms works (the server calls
# <base>/openai/v1/images/generations):
#   https://<resource>.openai.azure.com
#   https://<resource>.services.ai.azure.com
#   https://<resource>.cognitiveservices.azure.com
#   https://<resource>.openai.azure.com/openai/v1/images/generations   (used as-is)
# For OpenAI directly use: https://api.openai.com/v1
GPT_IMAGE_BASE_URL=
GPT_IMAGE_API_KEY=
# auto (api-key header for Azure hosts, Bearer otherwise) | api-key | bearer
GPT_IMAGE_AUTH_HEADER=auto

# Deployment names (not always the model name)
GPT_IMAGE_FLARE_MODEL=gpt-image-2.5-flare
GPT_IMAGE_SUNBURST_MODEL=gpt-image-2.5-sunburst

# ───────────── MAI-Image (2.6 and 2.6-Flash) ─────────────
# Foundry resource where MAI-Image-2.6 and MAI-Image-2.6-Flash are deployed.
# The server calls https://<resource>.services.ai.azure.com/mai/v1/images/generations;
# an openai.azure.com or cognitiveservices.azure.com address of the same
# resource is switched to services.ai.azure.com automatically.
#   https://<resource>.services.ai.azure.com
#   https://<resource>.services.ai.azure.com/mai/v1/images/generations   (used as-is)
MAI_BASE_URL=
MAI_API_KEY=
MAI_AUTH_HEADER=auto

# Deployment names (not always the model name)
MAI_IMAGE_MODEL=MAI-Image-2.6
MAI_IMAGE_FLASH_MODEL=MAI-Image-2.6-Flash

# ───────────── Per-model overrides (optional) ─────────────
# Only for a model deployed in yet another resource. Each falls back to its
# group above (GPT_IMAGE_* or MAI_*).
# GPT_IMAGE_FLARE_BASE_URL=
# GPT_IMAGE_FLARE_API_KEY=
# GPT_IMAGE_SUNBURST_BASE_URL=
# GPT_IMAGE_SUNBURST_API_KEY=
# MAI_IMAGE_BASE_URL=
# MAI_IMAGE_API_KEY=
# MAI_IMAGE_FLASH_BASE_URL=
# MAI_IMAGE_FLASH_API_KEY=

# ───────────── Judge (optional) ─────────────
# A vision model that checks each image against the checklist and rates its
# quality, without being told which model made it. Calls the Responses API
# (<base>/openai/v1/responses). Leave JUDGE_MODEL empty to tick the checklist
# by hand only. Uses the GPT-Image resource above unless JUDGE_* is set.
JUDGE_MODEL=gpt-5.5
# minimal | low | medium | high. Leave empty if the model doesn't reason.
JUDGE_REASONING_EFFORT=low
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_AUTH_HEADER=auto

# ───────────── Optional ─────────────

# List prices for the cost row, in USD per 1M tokens (text input / image output).
# Leave unset to use the published list prices (Oct 2026):
#   gpt-image-2.5-flare and -sunburst  5 in / 30 out
#   MAI-Image-2.6                      5 in / 38 out
#   MAI-Image-2.6-Flash             1.75 in / 19 out
# GPT_IMAGE_FLARE_PRICE_INPUT_PER_1M=5
# GPT_IMAGE_FLARE_PRICE_OUTPUT_PER_1M=30
# GPT_IMAGE_SUNBURST_PRICE_INPUT_PER_1M=5
# GPT_IMAGE_SUNBURST_PRICE_OUTPUT_PER_1M=30
# MAI_IMAGE_PRICE_INPUT_PER_1M=5
# MAI_IMAGE_PRICE_OUTPUT_PER_1M=38
# MAI_IMAGE_FLASH_PRICE_INPUT_PER_1M=1.75
# MAI_IMAGE_FLASH_PRICE_OUTPUT_PER_1M=19

PORT=3002

# Give up on a model after this many seconds (high-quality images can take a minute)
REQUEST_TIMEOUT_SECONDS=180

# Print every request and response body in the server console (images are left out)
DEBUG=false
