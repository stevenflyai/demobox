# ─────────────────────────────────────────────────────────────
# Decision models demo: fill in the providers you have, then run:
#   uv run server.py   (opens on http://localhost:3001)
# A provider with an empty URL or key is shown as "not configured";
# the others still run.
# ─────────────────────────────────────────────────────────────

# ───────────── Microsoft-Decision-1 (Microsoft Foundry) ─────────────
# Foundry resource endpoint from the deployment details page. Any of these works
# (the server calls <endpoint>/providers/microsoft/v1/systemone):
#   https://<resource>.services.ai.azure.com
#   https://<resource>.cognitiveservices.azure.com
#   https://<resource>.services.ai.azure.com/providers/microsoft/v1/systemone
MS_DECISION_BASE_URL=
MS_DECISION_API_KEY=
# Your deployment name (not the model name)
MS_DECISION_MODEL=Microsoft-Decision-1
# auto (api-key header for Azure hosts, Bearer otherwise) | api-key | bearer
MS_DECISION_AUTH_HEADER=auto

# ───────────── GPT Decisions API (OpenAI or Azure OpenAI) ─────────────
# The server calls <base>/decisions. Any of these works:
#   https://api.openai.com/v1
#   https://<resource>.openai.azure.com
#   https://<resource>.openai.azure.com/openai/v1
GPT_DECISION_BASE_URL=
GPT_DECISION_API_KEY=
# Model (OpenAI) or deployment name (Azure). gpt-6-luna is the only supported model today.
GPT_DECISION_MODEL=gpt-6-luna
GPT_DECISION_AUTH_HEADER=auto

# ───────────── Jev (TypeSafe) ─────────────
# The server calls <base>/v1/systemone. Leave the default for TypeSafe's own API.
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
# jev-latest, or a pinned version from GET /v1/models
JEV_MODEL=jev-latest
JEV_AUTH_HEADER=bearer

# ───────────── Optional ─────────────

# List prices for the cost row, in USD per 1M tokens. Leave unset to use the
# published list prices (Oct 2026): Microsoft-Decision-1 0.042 in / free out,
# gpt-6-luna Decisions 0.10 in / free out, Jev 0.042 in / free out.
# MS_DECISION_PRICE_INPUT_PER_1M=0.042
# MS_DECISION_PRICE_OUTPUT_PER_1M=0
# GPT_DECISION_PRICE_INPUT_PER_1M=0.10
# GPT_DECISION_PRICE_OUTPUT_PER_1M=0
# JEV_PRICE_INPUT_PER_1M=0.042
# JEV_PRICE_OUTPUT_PER_1M=0

PORT=3001

# Give up on a provider after this many seconds
REQUEST_TIMEOUT_SECONDS=30

# Print every request and response body in the server console
DEBUG=false
