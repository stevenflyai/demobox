# ─────────────────────────────────────────────────────────────
# Web IQ demo: fill in the search services you have and the answer model, then run:
#   npm start          (opens on http://localhost:3003)
# A service with no key is shown as "not configured"; the others still run.
# ─────────────────────────────────────────────────────────────

# ───────────── Microsoft Web IQ ─────────────
# Key from the Web IQ portal (limited access: https://www.microsoft.com/en-us/webiq).
# The server calls <base>/search/web or <base>/search/news with an x-apikey header.
WEBIQ_API_KEY=
WEBIQ_BASE_URL=https://api.microsoft.ai/v3
# passage (query-relevant passages, the default) | markdown | text | html
WEBIQ_CONTENT_FORMAT=passage
# strict (Web IQ's default: blocks adult, racy, violent, hate, and self-harm content) | off (blocks
# only illegal content; closer to the other services). Empty sends nothing. Web search only.
WEBIQ_SAFE_SEARCH=

# ───────────── Competitors (each optional) ─────────────
# Tavily: https://app.tavily.com  (POST /search, Bearer)
TAVILY_API_KEY=
# basic | fast | ultra-fast | advanced (advanced costs 2 credits)
TAVILY_SEARCH_DEPTH=basic

# Exa: https://dashboard.exa.ai  (POST /search, x-api-key; returns highlights)
EXA_API_KEY=
# auto | lite | deep-lite | deep
EXA_SEARCH_TYPE=auto

# Brave Search API: https://api-dashboard.search.brave.com  (GET /res/v1/web/search with extra_snippets)
BRAVE_API_KEY=

# Perplexity Search API: https://www.perplexity.ai/account/api  (POST /search, Bearer)
PERPLEXITY_API_KEY=

# Parallel: https://platform.parallel.ai  (POST /v1/search, x-api-key)
PARALLEL_API_KEY=
# turbo | fast ($1 per 1,000) | basic | advanced ($5 per 1,000). Comma-separate several
# to get one lane per mode; basic,advanced is the tier that compares with Web IQ's.
PARALLEL_MODE=basic,advanced

# SerpApi: https://serpapi.com/manage-api-key  (GET /search.json?engine=google, api_key in the query string)
# Google's own results page, scraped and parsed by SerpApi: short snippets, no page text.
SERPAPI_API_KEY=
# true makes every call a live Google search; false lets a repeat within an hour come from SerpApi's free cache
SERPAPI_NO_CACHE=true

# ───────────── Relevance judge ─────────────
# A model on an Azure OpenAI / Foundry resource, called with the Responses API
# (<base>/openai/v1/responses), grades every result 0-3 without being told
# which service returned it. Leave empty to compare without relevance grades.
#   https://<resource>.openai.azure.com
#   https://<resource>.services.ai.azure.com
MODEL_BASE_URL=
MODEL_API_KEY=
# auto (api-key header for Azure hosts, Bearer otherwise) | api-key | bearer
MODEL_AUTH_HEADER=auto
# Deployment name in that resource
JUDGE_MODEL=gpt-6.1-sol
# minimal | low | medium | high. Leave empty if the model doesn't reason.
JUDGE_REASONING_EFFORT=low

# ───────────── Decision models as relevance judges (optional) ─────────────
# Same settings as decision/.env. Each one grades every result with a 0-3 score
# question and its probabilities, instead of the LLM judge; pick one on the page.
# Microsoft-Decision-1 on Foundry: resource endpoint or the full /systemone URL
MS_DECISION_BASE_URL=
MS_DECISION_API_KEY=
MS_DECISION_MODEL=Microsoft-Decision-1
MS_DECISION_AUTH_HEADER=auto
# GPT Decisions API (OpenAI or Azure OpenAI): https://api.openai.com/v1 or https://<resource>.openai.azure.com
GPT_DECISION_BASE_URL=
GPT_DECISION_API_KEY=
GPT_DECISION_MODEL=gpt-6-luna
GPT_DECISION_AUTH_HEADER=auto
# Jev (TypeSafe)
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_AUTH_HEADER=auto
# Judge selected when the page opens: llm | microsoft | openai | jev
RELEVANCE_JUDGE=llm

# ───────────── Optional ─────────────

# List prices in USD per 1,000 searches for the cost column. Leave unset to use
# the published list prices (Oct 2026): Web IQ 7, Tavily 8 (basic, $0.008 per
# credit), Exa 7 (Exa also reports the actual charge, which is used when present),
# Brave 5, Perplexity 5, Parallel 5 (basic, advanced) or 1 (turbo, fast), SerpApi 15
# (Developer plan, $75 for 5,000).
# WEBIQ_PRICE_PER_1K=7
# TAVILY_PRICE_PER_1K=8
# EXA_PRICE_PER_1K=7
# BRAVE_PRICE_PER_1K=5
# PERPLEXITY_PRICE_PER_1K=5
# PARALLEL_PRICE_PER_1K=1
# SERPAPI_PRICE_PER_1K=15

PORT=3003

# Give up on a request after this many seconds
REQUEST_TIMEOUT_SECONDS=90

# Print every request and response body in the server console
DEBUG=false
